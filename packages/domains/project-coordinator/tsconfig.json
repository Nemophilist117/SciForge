{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sciforge/collaboration-contracts": ["../../collaboration-contracts/src/index.ts"],
      "@sciforge/collaboration-contracts/testing": ["../../collaboration-contracts/src/testing.ts"],
      "@sciforge/domain-collaboration/*": ["../collaboration/src/*"],
      "@sciforge/domain-sdk": ["../../domain-sdk/src/index.ts"],
      "@sciforge/domain-sdk/*": ["../../domain-sdk/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
