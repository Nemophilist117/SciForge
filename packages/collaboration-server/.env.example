# URL for the dedicated collaboration database. Keep the real value in the
# deployment secret manager; never commit it or print it in diagnostics.
SCIFORGE_COLLABORATION_DATABASE_URL=
SCIFORGE_COLLABORATION_DATABASE_POOL_SIZE=10
SCIFORGE_COLLABORATION_LISTEN_HOST=127.0.0.1
SCIFORGE_COLLABORATION_LISTEN_PORT=8787
SCIFORGE_COLLABORATION_BASE_PATH=
SCIFORGE_COLLABORATION_ALLOWED_ORIGINS=

# Optional strict OIDC User authentication. Leaving ISSUER empty keeps the
# process and database readiness probes available, but every User API remains
# fail-closed. Production issuers must use HTTPS. Insecure HTTP is accepted
# only for an explicitly enabled numeric loopback issuer in local tests.
SCIFORGE_COLLABORATION_OIDC_ISSUER=
SCIFORGE_COLLABORATION_OIDC_AUDIENCE=sciforge-cloud-api
SCIFORGE_COLLABORATION_OIDC_AUTHORIZED_PARTIES=sciforge-desktop,sciforge-web-mobile
SCIFORGE_COLLABORATION_OIDC_ALLOW_INSECURE_LOOPBACK=false

SCIFORGE_COLLABORATION_PROVIDER_CONFIG_FILE=
SCIFORGE_COLLABORATION_SECRET_DIRECTORY=

# Zulip binding confirmation has no anonymous or shared-secret environment
# fallback. It stays fail-closed until the host injects a trusted confirm
# authenticator for D's verified /bind event boundary.
